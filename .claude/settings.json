{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-decision-log.sh",
            "statusMessage": "檢查 spec 決策是否需要同步 Decision Log"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-infra-snapshot.sh",
            "statusMessage": "檢查 terraform apply 是否需要同步 infra 快照"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-tf-translation.sh",
            "statusMessage": "檢查 .tf 異動是否需要重新轉譯白話說明"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/track-pattern-usage.sh",
            "statusMessage": "累計 Pattern Card 使用次數"
          }
        ]
      }
    ]
  }
}
